# Frontend (Vite)
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Stream HLS / snapshot (opcional — servidor Node na loja ou dev local)
# Deixe VAZIO na Vercel até o backend existir (evita ERR_NAME_NOT_RESOLVED no console).
# VITE_API_URL=http://localhost:3456
# VITE_STREAM_API_ENABLED=false

# Dev local apenas: estabelecimento fixo (sem login). Em produção use Auth + seleção no painel.
# VITE_ESTABLISHMENT_ID=uuid-do-seu-estabelecimento

# Supabase (Edge Functions — configure no Dashboard ou CLI `supabase secrets`)
# URL completa do instalador Windows publicado no GitHub Releases (usada por `download-agent`):
# GITHUB_AGENT_INSTALLER_URL=https://github.com/ORG/REPO/releases/latest/download/OlhoVivoSetup.exe
# Em produção Windows o token vem do nome do executável (TOKEN_...) ou de .olhovivo.env.
# Para desenvolvimento: ESTABLISHMENT_TOKEN ou token.txt ao lado do código.
# ESTABLISHMENT_TOKEN=uuid-gerado-no-adminpanel
