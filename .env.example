# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# URL do backend local (Raspberry Pi ou localhost para dev)
# Em produção: http://IP_DO_PI:3456
VITE_API_URL=http://localhost:3456

# ── Servidor Node.js ──────────────────────────────────────────────────────────
PORT=3456
MEDIAMTX_API=http://127.0.0.1:9997

# URL base do HLS que o BROWSER vai usar para acessar o stream
# Em dev: http://localhost:8888
# Em produção: http://IP_DO_PI:8888  (deve ser acessível pela rede do cliente)
MEDIAMTX_HLS_URL=http://localhost:8888

# Origem(s) do frontend permitidas no CORS (separe por vírgula se houver mais de uma)
FRONTEND_URL=https://sistema-antifurto.vercel.app
